#!/usr/bin/env python3
"""A geocoder for Virginia State Corporation Commission records.

Reads normalized CSV produced by `crump`, geocodes any address not already in
the cache, and stores the result in addresses.db so later crump runs can attach
coordinates without hitting an API.

Virginia addresses go to the VGIN composite locator (run by VDEM, formerly
VITA); everything else goes to the Census geocoder.

    https://github.com/openva/crump/
"""

import argparse
import csv
import os
import sqlite3
import sys
import time

import requests

from pathlib import Path

# Run directly from a checkout without installing: the package sits one level
# up from bin/. A pip install takes precedence, since it is already on the path.
sys.path.insert(1, str(Path(__file__).resolve().parent.parent))

from crumplib import batch as batch_geocoder
from crumplib.geocache import address_hash
from crumplib.normalize import abbreviate_state, clean_text

csv.field_size_limit(1 << 24)

# The old gismaps.vita.virginia.gov host stopped resolving; Virginia moved GIS
# to VDEM. The service path is the same but the parameter names changed:
# Street/State/ZIP are now Address/Region/Postal.
VGIN_URL = (
    "https://vginmaps.vdem.virginia.gov/arcgis/rest/services/Geocoding/"
    "VGIN_Composite_Locator/GeocodeServer/findAddressCandidates"
)
CENSUS_URL = "https://geocoding.geo.census.gov/geocoder/locations/address"

#: Below this the VGIN match is too loose to trust.
MINIMUM_SCORE = 80

#: Consecutive API failures before we conclude the service is down.
MAX_CONSECUTIVE_ERRORS = 10

SCHEMA = """
CREATE TABLE IF NOT EXISTS addresses (
    address_hash TEXT PRIMARY KEY NOT NULL,
    address_cleaned TEXT,
    latitude REAL,
    longitude REAL,
    date INTEGER,
    source TEXT
)
"""

# Addresses we cannot geocode are recorded so we don't retry them forever.
FAILURE_SCHEMA = """
CREATE TABLE IF NOT EXISTS failures (
    address_hash TEXT PRIMARY KEY NOT NULL,
    attempted INTEGER,
    reason TEXT
)
"""

#: The single characters printed as each address is processed, and what they
#: mean. Shown as a key at the start of a run so the stream of symbols is
#: readable while it scrolls past.
PROGRESS_KEY = (
    ("+", "geocoded"),
    ("x", "no match"),
    ("C", "cached"),
    ("A", "no address"),
    ("F", "failed before"),
    ("!", "API error"),
)


def parse_args(argv=None):
    parser = argparse.ArgumentParser(
        description="A geocoder for Virginia State Corporation Commission records",
        epilog="https://github.com/openva/crump/",
    )
    parser.add_argument(
        "-i",
        "--input",
        required=True,
        metavar="file.csv",
        help="normalized CSV from crump, e.g. output/corp.csv",
    )
    parser.add_argument(
        "-p",
        "--prefix",
        default="",
        metavar="str",
        help="column prefix for the address to use, e.g. agent_",
    )
    parser.add_argument(
        "--cache",
        default="addresses.db",
        metavar="file",
        help="geocoded address cache (default: %(default)s)",
    )
    parser.add_argument(
        "-v",
        "--verbose",
        action="store_true",
        help="verbose mode",
    )
    parser.add_argument(
        "-l",
        "--limit",
        type=int,
        metavar="n",
        help="stop after n successful geocodes",
    )
    parser.add_argument(
        "--delay",
        type=float,
        default=1.0,
        metavar="seconds",
        help="minimum seconds between API calls (default: %(default)s)",
    )
    parser.add_argument(
        "--retry-failures",
        action="store_true",
        help="re-attempt addresses that previously failed",
    )
    parser.add_argument(
        "-b",
        "--batch",
        action="store_true",
        help=(
            "geocode non-Virginia addresses in bulk via the Census batch API "
            "(much faster; Virginia addresses still go to VGIN one at a time)"
        ),
    )
    parser.add_argument(
        "--batch-size",
        type=int,
        default=batch_geocoder.MAX_BATCH_SIZE,
        metavar="n",
        help="addresses per batch request (default: %(default)s, max %(default)s)",
    )
    parser.add_argument(
        "--batch-all",
        action="store_true",
        help=(
            "send Virginia addresses through the Census batch API too, rather "
            "than the more accurate VGIN locator"
        ),
    )
    parser.add_argument(
        "--allow-directional-conflicts",
        action="store_true",
        help=(
            "keep batch matches whose directional contradicts the input "
            "(e.g. '1 W Main' matching '1 E Main'); rejected by default"
        ),
    )
    return parser.parse_args(argv)


def connect(path):
    """Open the cache, creating the schema if needed."""
    try:
        db = sqlite3.connect(path)
    except sqlite3.Error as error:
        sys.exit("Could not connect to SQLite: %s" % error)
    db.execute(SCHEMA)
    db.execute(FAILURE_SCHEMA)
    db.commit()
    return db


def is_postal_box(street):
    """Whether a street line is a PO box or a care-of line, not a location."""
    lowered = street.lower().lstrip()
    for prefix in ("po box", "p.o. box", "p. o. box", "post office box"):
        if lowered.startswith(prefix):
            return True
    for prefix in ("c/o ", "attn:", "attn ", "care of "):
        if lowered.startswith(prefix):
            return True
    return False


def street_for_lookup(street_1, street_2):
    """Combine the street lines, dropping the ones that aren't locations.

    The old code deleted dict keys and then read them back, relying on a bare
    `except` to paper over the KeyError; this just filters a list.
    """
    usable = [
        street
        for street in (clean_text(street_1), clean_text(street_2))
        if street and not is_postal_box(street)
    ]
    return ", ".join(usable)


def geocode_virginia(session, street, city, state, zip_code, timeout=30):
    """Geocode via the VGIN composite locator. Returns a result dict or None."""
    response = session.get(
        VGIN_URL,
        params={
            "Address": street,
            "City": city,
            "Region": state,
            "Postal": zip_code,
            "maxLocations": "1",
            "f": "json",
        },
        timeout=timeout,
    )
    response.raise_for_status()
    candidates = response.json().get("candidates") or []
    if not candidates:
        return None, "no candidates"

    best = candidates[0]
    if best.get("score", 0) < MINIMUM_SCORE:
        return None, "score %s below %s" % (best.get("score"), MINIMUM_SCORE)

    # A very short match means we got a ZIP centroid, not a street address.
    if len(best.get("address", "")) < 6:
        return None, "ZIP centroid only"

    location = best.get("location") or {}
    if location.get("x") is None or location.get("y") is None:
        return None, "no coordinates"

    return {
        "address": best["address"],
        "longitude": location["x"],
        "latitude": location["y"],
        "source": "VGIN",
    }, None


def geocode_census(session, street, city, state, zip_code, timeout=30):
    """Geocode via the Census geocoder. Returns a result dict or None."""
    response = session.get(
        CENSUS_URL,
        params={
            "street": street,
            "city": city,
            "state": state,
            "zip": zip_code,
            "benchmark": "Public_AR_Current",
            "format": "json",
        },
        timeout=timeout,
    )
    response.raise_for_status()
    matches = response.json().get("result", {}).get("addressMatches") or []
    if not matches:
        return None, "no candidates"

    best = matches[0]
    coordinates = best.get("coordinates") or {}
    if coordinates.get("x") is None or coordinates.get("y") is None:
        return None, "no coordinates"

    return {
        "address": best.get("matchedAddress", ""),
        "longitude": coordinates["x"],
        "latitude": coordinates["y"],
        # Record which API actually answered. The old code labeled every
        # non-Virginia result 'VITA', which made the provenance wrong for
        # every out-of-state row.
        "source": "Census",
    }, None


def collect_addresses(options, db, fields):
    """Read the input CSV and return the addresses that still need geocoding.

    Deduplicates by address hash, so an address shared by a thousand entities
    is geocoded once. Skips anything already cached or previously failed.
    """
    cursor = db.cursor()
    pending = {}
    counts = {"cached": 0, "skipped": 0, "duplicate": 0}

    with open(options.input, encoding="utf-8", errors="replace", newline="") as handle:
        reader = csv.DictReader(handle)
        missing = [name for name in fields.values() if name not in reader.fieldnames]
        if missing:
            sys.exit(f"Error: {options.input} has no column(s): {', '.join(missing)}")

        for row in reader:
            street_1 = clean_text(row.get(fields["street_1"]))
            street_2 = clean_text(row.get(fields["street_2"]))
            city = clean_text(row.get(fields["city"]))
            state = abbreviate_state(row.get(fields["state"]))
            zip_code = clean_text(row.get(fields["zip"]))

            if not street_1 and not street_2:
                counts["skipped"] += 1
                continue

            digest = address_hash(street_1, street_2, city, state, zip_code)
            if digest in pending:
                counts["duplicate"] += 1
                continue

            cursor.execute("SELECT 1 FROM addresses WHERE address_hash = ?", (digest,))
            if cursor.fetchone():
                counts["cached"] += 1
                continue

            if not options.retry_failures:
                cursor.execute(
                    "SELECT 1 FROM failures WHERE address_hash = ?", (digest,)
                )
                if cursor.fetchone():
                    counts["skipped"] += 1
                    continue

            street = street_for_lookup(street_1, street_2)
            if not street:
                # PO boxes and care-of lines are not locations; the Census
                # service never matches them, so don't spend a slot on them.
                _record_failure(db, digest, "no usable street line")
                counts["skipped"] += 1
                continue

            pending[digest] = {
                "id": digest,
                "street": street,
                "city": city,
                "state": state,
                "zip": zip_code,
            }

    return pending, counts


def run_batches(options, db, pending, session):
    """Geocode pending addresses via the Census batch API."""
    counts = {"geocoded": 0, "failed": 0}
    size = min(options.batch_size, batch_geocoder.MAX_BATCH_SIZE)
    total_batches = (len(pending) + size - 1) // size

    for number, chunk in enumerate(
        batch_geocoder.chunked(pending.values(), size), start=1
    ):
        print(
            f"  batch {number}/{total_batches} ({len(chunk)} addresses)",
            end="",
            flush=True,
        )
        try:
            matches, rejected = batch_geocoder.geocode_batch(
                chunk,
                session=session,
                reject_directional_conflicts=(not options.allow_directional_conflicts),
            )
        except batch_geocoder.BatchError as error:
            print(f" -> failed: {error}")
            continue

        for digest, result in matches.items():
            db.execute(
                "INSERT OR REPLACE INTO addresses VALUES (?, ?, ?, ?, ?, ?)",
                (
                    digest,
                    result["address"],
                    result["latitude"],
                    result["longitude"],
                    int(time.time()),
                    result["source"],
                ),
            )
        for digest, reason in rejected.items():
            db.execute(
                "INSERT OR REPLACE INTO failures VALUES (?, ?, ?)",
                (digest, int(time.time()), reason),
            )
        db.commit()

        counts["geocoded"] += len(matches)
        counts["failed"] += len(rejected)
        rate = 100.0 * len(matches) / len(chunk) if chunk else 0.0
        print(f" -> {len(matches)} matched ({rate:.0f}%)")

    return counts


def run_batch_mode(options, db, session, fields):
    """Bulk-geocode via the Census batch API.

    Virginia addresses go to VGIN one at a time unless --batch-all, because the
    state locator is more accurate for Virginia than the national Census data.
    """
    print(f"Reading {options.input}")
    pending, counts = collect_addresses(options, db, fields)
    print(
        f"  {len(pending):,} addresses need geocoding "
        f"({counts['cached']:,} cached, {counts['duplicate']:,} duplicates, "
        f"{counts['skipped']:,} skipped)"
    )

    if not pending:
        db.close()
        print("Nothing to do.")
        return 0

    virginia = {}
    if not options.batch_all:
        virginia = {
            digest: row for digest, row in pending.items() if row["state"] == "VA"
        }
        for digest in virginia:
            del pending[digest]

    batch_counts = {"geocoded": 0, "failed": 0}
    if pending:
        print(f"Batch geocoding {len(pending):,} addresses via Census")
        batch_counts = run_batches(options, db, pending, session)

    # Virginia addresses still go through VGIN, one request at a time.
    serial_counts = {"geocoded": 0, "failed": 0}
    if virginia:
        print(
            f"Geocoding {len(virginia):,} Virginia addresses via VGIN (one at a time)"
        )
        serial_counts = run_serial(options, db, session, virginia)

    db.close()
    print(
        f"\n{batch_counts['geocoded'] + serial_counts['geocoded']:,} geocoded, "
        f"{counts['cached']:,} already cached, "
        f"{batch_counts['failed'] + serial_counts['failed']:,} failed"
    )
    return 0


def run_serial(options, db, session, rows):
    """Geocode addresses one at a time through VGIN."""
    counts = {"geocoded": 0, "failed": 0}
    consecutive_errors = 0
    last_error = None

    # Only useful when single characters are actually being printed.
    if not options.verbose:
        print_progress_key()

    for digest, row in rows.items():
        started = time.monotonic()
        try:
            result, reason = geocode_virginia(
                session, row["street"], row["city"], row["state"], row["zip"]
            )
            consecutive_errors = 0
        except requests.RequestException as error:
            consecutive_errors += 1
            last_error = error
            _tick(options, "!", f"API error: {error}")
            if consecutive_errors >= MAX_CONSECUTIVE_ERRORS:
                print(halt_message(consecutive_errors, last_error, VGIN_URL))
                break
            continue

        if result is None:
            _record_failure(db, digest, reason)
            counts["failed"] += 1
            _tick(options, "x", f"failed: {reason}")
        else:
            db.execute(
                "INSERT OR REPLACE INTO addresses VALUES (?, ?, ?, ?, ?, ?)",
                (
                    digest,
                    result["address"],
                    result["latitude"],
                    result["longitude"],
                    int(time.time()),
                    result["source"],
                ),
            )
            db.commit()
            counts["geocoded"] += 1
            _tick(options, "+", f"geocoded: {result['address']}")
            if options.limit and counts["geocoded"] >= options.limit:
                break

        elapsed = time.monotonic() - started
        if elapsed < options.delay:
            time.sleep(options.delay - elapsed)

    if not options.verbose:
        sys.stdout.write("\n")
    return counts


def main(argv=None):
    options = parse_args(argv)
    db = connect(options.cache)
    cursor = db.cursor()
    session = requests.Session()

    fields = {
        role: options.prefix + role
        for role in ("street_1", "street_2", "city", "state", "zip")
    }

    if options.batch:
        return run_batch_mode(options, db, session, fields)

    if not options.verbose:
        print_progress_key()

    consecutive_errors = 0
    last_error = None
    counts = {"cached": 0, "skipped": 0, "geocoded": 0, "failed": 0}

    with open(options.input, encoding="utf-8", errors="replace", newline="") as handle:
        reader = csv.DictReader(handle)
        missing = [name for name in fields.values() if name not in reader.fieldnames]
        if missing:
            sys.exit(
                "Error: %s has no column(s): %s" % (options.input, ", ".join(missing))
            )

        for row in reader:
            street_1 = clean_text(row.get(fields["street_1"]))
            street_2 = clean_text(row.get(fields["street_2"]))
            city = clean_text(row.get(fields["city"]))
            state = abbreviate_state(row.get(fields["state"]))
            zip_code = clean_text(row.get(fields["zip"]))

            if not street_1 and not street_2:
                counts["skipped"] += 1
                _tick(options, "A")
                continue

            digest = address_hash(street_1, street_2, city, state, zip_code)

            cursor.execute("SELECT 1 FROM addresses WHERE address_hash = ?", (digest,))
            if cursor.fetchone():
                counts["cached"] += 1
                _tick(options, "C")
                continue

            if not options.retry_failures:
                cursor.execute(
                    "SELECT 1 FROM failures WHERE address_hash = ?", (digest,)
                )
                if cursor.fetchone():
                    counts["skipped"] += 1
                    _tick(options, "F")
                    continue

            street = street_for_lookup(street_1, street_2)
            if not street:
                _record_failure(db, digest, "no usable street line")
                counts["failed"] += 1
                _tick(options, "x")
                continue

            started = time.monotonic()
            geocoder = geocode_virginia if state == "VA" else geocode_census

            try:
                result, reason = geocoder(session, street, city, state, zip_code)
                consecutive_errors = 0
            except requests.RequestException as error:
                consecutive_errors += 1
                last_error = error
                _tick(options, "!", f"API error: {error}")
                if consecutive_errors >= MAX_CONSECUTIVE_ERRORS:
                    url = VGIN_URL if state == "VA" else CENSUS_URL
                    db.close()
                    sys.exit(halt_message(consecutive_errors, last_error, url))
                continue

            if result is None:
                # Record the failure so we don't look this address up again on
                # every future run.
                _record_failure(db, digest, reason)
                counts["failed"] += 1
                _tick(options, "x", "failed: %s" % reason)
            else:
                db.execute(
                    "INSERT OR REPLACE INTO addresses VALUES (?, ?, ?, ?, ?, ?)",
                    (
                        digest,
                        result["address"],
                        result["latitude"],
                        result["longitude"],
                        int(time.time()),
                        result["source"],
                    ),
                )
                db.commit()
                counts["geocoded"] += 1
                _tick(
                    options,
                    "+",
                    "geocoded: %s (%.5f, %.5f)"
                    % (result["address"], result["latitude"], result["longitude"]),
                )
                if options.limit and counts["geocoded"] >= options.limit:
                    break

            # Stay under the rate limit, counting time already spent.
            elapsed = time.monotonic() - started
            if elapsed < options.delay:
                time.sleep(options.delay - elapsed)

    db.close()
    print(
        "\n%d geocoded, %d already cached, %d skipped, %d failed"
        % (
            counts["geocoded"],
            counts["cached"],
            counts["skipped"],
            counts["failed"],
        )
    )
    return 0


def _record_failure(db, digest, reason):
    db.execute(
        "INSERT OR REPLACE INTO failures VALUES (?, ?, ?)",
        (digest, int(time.time()), reason),
    )
    db.commit()


def halt_message(count, error, url):
    """Explain why geocoding stopped, including the error that caused it.

    The count alone is not actionable: a DNS failure, a timeout and an HTTP 503
    all look identical as a row of `!` characters. Quoting the last error and
    naming the service is usually enough to tell "the API is down" from "the
    network is down" from "we are being rate-limited".
    """
    lines = [
        f"\nStopping: {count} consecutive API errors.",
        f"  Service: {url}",
        f"  Last error: {error}",
        f"  Error type: {type(error).__name__}",
    ]
    return "\n".join(lines)


def print_progress_key():
    """Print the legend for the per-address progress characters.

    No label prefix: the legend reads as one already, and the line has to fit
    an 80-column terminal without wrapping.
    """
    print("  ".join(f"{symbol} {meaning}" for symbol, meaning in PROGRESS_KEY))


def _tick(options, symbol, message=None):
    """Emit progress: a line in verbose mode, a single character otherwise."""
    if options.verbose:
        if message:
            print(message)
    else:
        sys.stdout.write(symbol)
        sys.stdout.flush()


if __name__ == "__main__":
    sys.exit(main())
