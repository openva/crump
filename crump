#!/usr/bin/env python3
"""A normalizer for Virginia State Corporation Commission business records.

The SCC publishes its business entity data as a ZIP of CSVs. Crump reads those,
cleans up the fixed-width residue they still carry, expands the codes the SCC
leaves raw, attaches coordinates from a cache of geocoded addresses, and emits
CSV and JSON.

    https://github.com/openva/crump/
"""

import argparse
import csv
import os
import sys

from crumplib import download as downloader
from crumplib import publish
from crumplib.atomize import Atomizer, group_related
from crumplib.geocache import GeocodeCache
from crumplib.jurisdiction import JurisdictionIndex
from crumplib.localities import ENTITY_STEMS, LocalityWriter
from crumplib.maps import load_maps
from crumplib.output import CsvWriter, JsonArrayWriter, JsonLinesWriter
from crumplib.records import RecordNormalizer

# Entity names and addresses can be long; the default field limit is not enough
# for a 647 MB CSV with quoted free-text columns.
csv.field_size_limit(1 << 24)

#: The six maps that describe entities. Each row is one business entity, and
#: entity IDs are unique across all six, so they share one atomized namespace.
ENTITY_MAPS = ("corp", "llc", "lp", "gp", "bt", "psa")

#: Maps whose rows hang off an entity, and the key each is nested under when
#: atomizing. ReservedName is excluded: it is keyed by reservation number, not
#: entity ID, so it has no entity to attach to.
RELATED_MAPS = {
    "officer": "officers",
    "namehistory": "name_history",
    "amendment": "amendments",
    "merger": "mergers",
}


def parse_args(argv=None):
    parser = argparse.ArgumentParser(
        description=("A normalizer for Virginia State Corporation Commission records"),
        epilog="https://github.com/openva/crump/",
    )
    parser.add_argument(
        "-i",
        "--input",
        default="data",
        metavar="dir",
        help="directory holding the SCC CSVs (default: %(default)s)",
    )
    parser.add_argument(
        "-o",
        "--output",
        default="output",
        metavar="dir",
        help="directory for JSON and CSV (default: %(default)s)",
    )
    parser.add_argument(
        "-d",
        "--download",
        action="store_true",
        help="download and extract the current data file",
    )
    parser.add_argument(
        "-g",
        "--geocode",
        action="store_true",
        help="attach coordinates from the geocoded address cache",
    )
    parser.add_argument(
        "--cache",
        default="addresses.db",
        metavar="file",
        help="geocoded address cache (default: %(default)s)",
    )
    parser.add_argument(
        "-j",
        "--jurisdiction",
        action="store_true",
        help=(
            "assign each principal office to the Virginia county or "
            "independent city containing it (implies -g)"
        ),
    )
    parser.add_argument(
        "-L",
        "--localities",
        action="store_true",
        help=(
            "write one CSV per Virginia county and independent city, for "
            "local business-licensure use (implies -j)"
        ),
    )
    parser.add_argument(
        "--localities-dir",
        default=None,
        metavar="dir",
        help="where locality CSVs go (default: <output>/localities)",
    )
    parser.add_argument(
        "--boundaries",
        default=None,
        metavar="file",
        help=(
            "jurisdiction boundary file "
            "(default: boundaries/va_jurisdictions.geojson.gz)"
        ),
    )
    parser.add_argument(
        "--maps",
        default="table_maps",
        metavar="dir",
        help="directory of YAML field maps (default: %(default)s)",
    )
    parser.add_argument(
        "--json",
        choices=("array", "lines", "none"),
        default="lines",
        help="JSON output format (default: %(default)s)",
    )
    parser.add_argument(
        "--no-csv",
        action="store_true",
        help="skip CSV output",
    )
    parser.add_argument(
        "-a",
        "--atomize",
        action="store_true",
        help="write one JSON file per entity, for serving a static API",
    )
    parser.add_argument(
        "--atomize-dir",
        default=None,
        metavar="dir",
        help="where per-entity JSON goes (default: <output>/entity)",
    )
    parser.add_argument(
        "--atomize-indent",
        type=int,
        default=None,
        metavar="n",
        help="indent per-entity JSON by n spaces (default: compact)",
    )
    parser.add_argument(
        "--no-related",
        action="store_true",
        help="when atomizing, omit officers, names, amendments, and mergers",
    )
    parser.add_argument(
        "--publish",
        metavar="bucket",
        help=(
            "sync generated files to this S3 bucket: per-entity JSON and "
            "locality CSVs (implies -a and -L, and so -j and -g)"
        ),
    )
    parser.add_argument(
        "--publish-prefix",
        default="entity",
        metavar="path",
        help="key prefix for per-entity JSON (default: %(default)s)",
    )
    parser.add_argument(
        "--localities-prefix",
        default="localities",
        metavar="path",
        help="key prefix for locality CSVs (default: %(default)s)",
    )
    parser.add_argument(
        "--publish-dry-run",
        action="store_true",
        help="show what would be uploaded, without uploading",
    )
    parser.add_argument(
        "-l",
        "--limit",
        type=int,
        metavar="n",
        help="stop after n records per file (for testing)",
    )
    parser.add_argument(
        "-f",
        "--files",
        nargs="+",
        metavar="stem",
        help="only process these maps, e.g. corp llc",
    )
    return parser.parse_args(argv)


def human(number):
    """Format a count with thousands separators."""
    return f"{number:,}"


def process(
    field_map,
    source_path,
    output_dir,
    options,
    cache,
    atomizer=None,
    related=None,
    jurisdictions=None,
    localities=None,
):
    """Normalize one CSV file. Returns (records written, normalizer)."""
    normalizer = RecordNormalizer(
        field_map,
        cache if options.geocode else None,
        jurisdictions=jurisdictions,
    )
    names = field_map.output_names

    writers = []
    if not options.no_csv:
        writers.append(
            CsvWriter(os.path.join(output_dir, field_map.stem + ".csv"), names)
        )
    if options.json == "array":
        writers.append(
            JsonArrayWriter(os.path.join(output_dir, field_map.stem + ".json"))
        )
    elif options.json == "lines":
        writers.append(
            JsonLinesWriter(os.path.join(output_dir, field_map.stem + ".jsonl"))
        )

    written = 0
    try:
        with open(
            source_path, encoding="utf-8", errors="replace", newline=""
        ) as handle:
            for row in csv.DictReader(handle):
                # Every data row carries one extra field, a trailing-comma
                # artifact of the old fixed-width format. DictReader files it
                # under None; drop it so it never reaches the output.
                row.pop(None, None)
                record = normalizer.normalize(row)
                for writer in writers:
                    writer.write(record)
                if atomizer is not None:
                    atomizer.write(
                        record.get("id"),
                        _entity_document(record, field_map.stem, related),
                    )
                if localities is not None:
                    localities.write(record, field_map.stem)
                written += 1
                if options.limit and written >= options.limit:
                    break
    finally:
        for writer in writers:
            writer.close()

    return written, normalizer


def _entity_document(record, entity_type, related):
    """Build the per-entity document: the record plus its related records.

    `entity_type` is included so a consumer holding only an ID knows what it
    has -- the atomized namespace is flat, so the document has to say.
    """
    document = dict(record)
    document["entity_type"] = entity_type
    if not related:
        return document
    entity_id = record.get("id")
    for key, index in related.items():
        matches = index.get(entity_id)
        if matches:
            document[key] = matches
    return document


def _normalized_rows(handle, normalizer):
    """Yield normalized records from an open CSV file."""
    for row in csv.DictReader(handle):
        row.pop(None, None)
        yield normalizer.normalize(row)


def load_related(maps, options):
    """Index the related-record files by entity ID, for atomizing.

    Normalized through the same maps as everything else, so an atomized
    officer looks like an officer in officer.csv.
    """
    related = {}
    for stem, key in RELATED_MAPS.items():
        field_map = maps.get(stem)
        if field_map is None:
            continue
        source_path = os.path.join(options.input, field_map.csv_name)
        if not os.path.isfile(source_path):
            continue
        normalizer = RecordNormalizer(field_map, None)
        print(f"  indexing {field_map.csv_name}", end="", flush=True)
        with open(
            source_path, encoding="utf-8", errors="replace", newline=""
        ) as handle:
            related[key] = group_related(
                source_path, "id", _normalized_rows(handle, normalizer)
            )
        print(f" -> {human(len(related[key]))} entities")
    return related


def main(argv=None):
    options = parse_args(argv)

    # --publish means "publish everything Crump produces": both the per-entity
    # JSON and the locality CSVs, unless the run already asked for a subset.
    # Note this pulls in geocoding and jurisdiction assignment, since locality
    # files are grouped by jurisdiction -- so a bare --publish needs the address
    # cache and costs a couple of extra minutes.
    if options.publish:
        options.atomize = True
        options.localities = True

    # Locality files are grouped by jurisdiction, which is derived from
    # coordinates -- so each option implies the one below it.
    if options.localities:
        options.jurisdiction = True
    if options.jurisdiction:
        options.geocode = True

    if options.download:
        print(f"Downloading business data from {downloader.DOWNLOAD_URL}")
        try:
            archive = downloader.download(
                progress=lambda n: _progress(n),
            )
            sys.stdout.write("\n")
            extracted = downloader.extract(archive, options.input)
        except downloader.DownloadError as error:
            sys.exit(f"Error: {error}")
        print(f"Extracted {len(extracted)} CSV files to {options.input}/")

    if not os.path.isdir(options.input):
        sys.exit(
            f"Error: input directory {options.input!r} not found. "
            "Use -d to download the data."
        )

    maps = load_maps(options.maps)
    if options.files:
        unknown = set(options.files) - set(maps)
        if unknown:
            sys.exit(f"Error: no such map(s): {', '.join(sorted(unknown))}")
        maps = {stem: maps[stem] for stem in options.files}

    os.makedirs(options.output, exist_ok=True)

    cache = None
    if options.geocode:
        cache = GeocodeCache(options.cache)
        if cache.available:
            print(f"Loaded {human(len(cache))} cached addresses from {options.cache}")
        else:
            print(
                f"Warning: no usable address cache at {options.cache}; "
                "skipping geocoding"
            )

    # Atomizing needs the related records in hand before the entity pass, so
    # each entity document can carry its officers, names, amendments, mergers.
    related = None
    atomize_root = None
    if options.atomize:
        atomize_root = options.atomize_dir or os.path.join(options.output, "entity")
        if options.no_related:
            print(f"Atomizing to {atomize_root}/ (entities only)")
        else:
            print("Indexing related records for atomizing")
            related = load_related(maps, options)

    jurisdictions = None
    if options.jurisdiction:
        try:
            jurisdictions = JurisdictionIndex(options.boundaries)
        except (OSError, ValueError) as error:
            sys.exit(f"Error: could not load jurisdiction boundaries: {error}")
        print(
            f"Loaded {len(jurisdictions)} Virginia jurisdictions "
            f"(counties and independent cities)"
        )

    if options.publish:
        print(
            "Publishing: will generate per-entity JSON and locality CSVs "
            "(implies -a, -L, -j, -g)"
        )

    localities = None
    localities_dir = None
    if options.localities:
        localities_dir = options.localities_dir or os.path.join(
            options.output, "localities"
        )
        localities = LocalityWriter(localities_dir)
        print(f"Writing locality files to {localities_dir}/")

    total = 0
    unknown_codes = {}
    atomizer_stats = {"written": 0, "skipped": 0}
    for stem in sorted(maps):
        field_map = maps[stem]
        source_path = os.path.join(options.input, field_map.csv_name)
        if not os.path.isfile(source_path):
            print(f"Skipping {stem} (no {field_map.csv_name})")
            continue

        atomizer = None
        if options.atomize and stem in ENTITY_MAPS:
            atomizer = Atomizer(atomize_root, indent=options.atomize_indent)

        print(f"Processing {field_map.csv_name}", end="", flush=True)
        written, normalizer = process(
            field_map,
            source_path,
            options.output,
            options,
            cache,
            atomizer=atomizer,
            related=related,
            jurisdictions=jurisdictions,
            localities=localities if stem in ENTITY_STEMS else None,
        )
        if atomizer is not None:
            atomizer_stats["written"] += atomizer.written
            atomizer_stats["skipped"] += atomizer.skipped
            print(
                f" -> {human(written)} records, {human(atomizer.written)} entity files"
            )
        else:
            print(f" -> {human(written)} records")
        total += written
        for key, count in normalizer.unknown_codes.items():
            unknown_codes[key] = unknown_codes.get(key, 0) + count

    print(f"\nWrote {human(total)} records to {options.output}/")

    if options.atomize:
        print(
            f"Wrote {human(atomizer_stats['written'])} per-entity JSON files "
            f"to {atomize_root}/"
        )
        if atomizer_stats["skipped"]:
            print(
                f"  skipped {human(atomizer_stats['skipped'])} records "
                "with unusable entity IDs"
            )

    if cache is not None and cache.available:
        looked_up = cache.hits + cache.misses
        if looked_up:
            print(
                f"Geocoded {human(cache.hits)} of {human(looked_up)} "
                f"addresses from cache "
                f"({100.0 * cache.hits / looked_up:.1f}%)"
            )
        cache.close()

    if localities is not None:
        counts = localities.counts()
        localities.close()
        print(
            f"Wrote {human(localities.written)} businesses across "
            f"{len(counts)} locality files in {localities_dir}/"
        )

    if options.publish:
        if options.atomize:
            _publish(
                options,
                atomize_root,
                options.publish_prefix,
                "per-entity JSON",
                "*.json",
            )
        if options.localities:
            _publish(
                options,
                localities_dir,
                options.localities_prefix,
                "locality CSVs",
                "*.csv",
            )

    # Surface codes the maps don't document, rather than silently passing them
    # through -- this is how we learn the SCC added a value.
    if unknown_codes:
        print("\nUndocumented codes (passed through unchanged):")
        for (field, code), count in sorted(
            unknown_codes.items(), key=lambda item: -item[1]
        ):
            print(f"  {field} = {code!r} ({human(count)} rows)")

    return 0


def _publish(options, source, prefix, label, include):
    """Sync one directory of generated files to S3."""
    if source is None or not os.path.isdir(source):
        print(f"\nWarning: nothing to publish for {label} ({source} not found)")
        return

    # An empty directory means the run produced nothing -- usually a missing
    # address cache. Syncing it would leave whatever is already on S3 in place,
    # so say so rather than reporting a successful no-op.
    if not os.listdir(source):
        print(
            f"\nWarning: no {label} were generated, so none were published. "
            f"Anything already in s3://{options.publish}/{prefix} is unchanged."
        )
        return

    command = publish.sync_command(
        source,
        options.publish,
        prefix=prefix,
        dry_run=options.publish_dry_run,
        include=include,
    )
    print(f"\nPublishing {label} to s3://{options.publish}/{prefix}")
    print("  " + " ".join(command))
    try:
        output = publish.sync(
            source,
            options.publish,
            prefix=prefix,
            dry_run=options.publish_dry_run,
            include=include,
        )
    except publish.PublishError as error:
        # A failed upload should not discard a successful parse.
        print(f"  Warning: {error}")
        return
    # sync is chatty; the tail is what matters.
    lines = [line for line in output.splitlines() if line.strip()]
    for line in lines[-3:]:
        print("  " + line)
    print(f"  {len(lines)} objects processed")


def _progress(downloaded):
    sys.stdout.write(f"\r  {downloaded >> 20:,} MB")
    sys.stdout.flush()


if __name__ == "__main__":
    sys.exit(main())
